# Copy this file to .env and fill in real values. Never commit .env.

# ── Database ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sweet_crispy

# ── Server ────────────────────────────────────────────────────
PORT=3000
# Public URL of this site, used to build Stripe redirect links (no trailing slash)
CLIENT_URL=http://localhost:3000

# ── Staff login ───────────────────────────────────────────────
# The server REFUSES TO START if this is missing, left as "change-me", or
# shorter than 4 characters. Staff exchange this once for a session cookie.
ADMIN_PIN=change-me

# ── Optional ──────────────────────────────────────────────────
# Only set CORS_ORIGIN if the frontend is served from a different host than
# this API. Left unset, cross-origin browser requests are refused, which is
# what you want for a single-server deployment.
# CORS_ORIGIN=https://your-frontend-domain

# ── Card payments ─────────────────────────────────────────────
# Which gateway handles cards:
#   none    cash only — the card option never appears (safe default)
#   epay    Republic Bank EPay  (see lib/payments/epay.js — needs completing)
#   stripe  Stripe Checkout     (not available to Grenada-based merchants)
PAYMENT_PROVIDER=none

# ── Republic Bank EPay ────────────────────────────────────────
# From the merchant integration pack. The secret signs requests and verifies
# callbacks — it must NEVER be exposed to the browser or committed to git.
# EPAY_MERCHANT_ID=
# EPAY_SECRET=
# EPAY_CHECKOUT_URL=

# ── Stripe (only if PAYMENT_PROVIDER=stripe) ──────────────────
# Test keys (sk_test_ / pk_test_) until you go live. Secret key is server-only.
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Signing secret from the webhook endpoint you add at
# <CLIENT_URL>/api/payments/webhook
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Contact ───────────────────────────────────────────────────
WHATSAPP_NUMBER=14735369931
